root = true

[*.cs]
# ---------------------------------------------------------------------------
# Analyzer tuning for the CI "scan" gate (dotnet build -warnaserror).
# Genuine bug/correctness/security rules stay at warning (enforced). The rules
# below are silenced with justification so the gate is meaningful, not noisy.
# ---------------------------------------------------------------------------

# CA1848: "use LoggerMessage delegates for performance" — micro-optimization not
# warranted for this app's logging volume; standard ILogger calls are intentional.
dotnet_diagnostic.CA1848.severity = none

# CA1862: prefer Contains(..., StringComparison) over ToLower()+Contains — the
# code deliberately lowercases input once for readability; behavior is correct.
dotnet_diagnostic.CA1862.severity = none

# SCS0016: CSRF anti-forgery token on controller POST — not applicable. This is a
# stateless Web API authenticated by bearer tokens (no cookie/session auth), so
# anti-forgery tokens are not the relevant protection.
dotnet_diagnostic.SCS0016.severity = none
